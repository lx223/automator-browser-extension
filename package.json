{
  "name": "overtabbed-browser-extension",
  "version": "0.0.1",
  "description": "A modern browser extension built with TypeScript, React, and Vite",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm proto:generate && pnpm run copy-manifest && vite",
    "build": "pnpm proto:generate && tsc && vite build && pnpm run copy-manifest",
    "copy-manifest": "mkdir -p dist && cp src/manifest.json dist/ && cp -r src/icons dist/",
    "preview": "vite preview",
    "type-check": "pnpm proto:generate && tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "proto:generate": "buf generate",
    "proto:lint": "buf lint && buf format --diff --exit-code",
    "proto:check": "pnpm proto:lint && buf build -o /dev/null",
    "test": "pnpm proto:generate && node --import tsx --test tests/browserModels.test.ts"
  },
  "keywords": [
    "browser-extension",
    "chrome",
    "safari",
    "typescript",
    "react",
    "vite"
  ],
  "author": "lx223",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/chrome": "^0.0.284",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
