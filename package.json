{
  "name": "overtabbed-browser-extension",
  "version": "1.0.0",
  "description": "A Chrome extension that automates tab management with custom rules",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "NODE_ENV=development vite build --watch --mode development",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "generate-icons": "tsx scripts/generate-icons.ts"
  },
  "keywords": [
    "chrome-extension",
    "tab-automation",
    "browser-extension"
  ],
  "author": "lx223",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.1.29",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "hot-reload-extension-vite": "^1.1.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
