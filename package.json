{
  "name": "overtabbed-browser-extension",
  "version": "1.0.0",
  "description": "A Chrome extension to manage all tabs in a convenient and visual way",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm codegen && NODE_ENV=development vite build --watch --mode development",
    "build": "pnpm codegen && vite build",
    "test": "pnpm codegen && vitest run",
    "test:watch": "vitest",
    "lint": "pnpm proto:lint && pnpm type-check",
    "type-check": "pnpm codegen && tsc --noEmit",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "codegen": "node scripts/codegen.mjs",
    "proto:generate": "pnpm codegen",
    "proto:lint": "buf lint --config '{\"version\":\"v2\",\"modules\":[{\"path\":\"proto\"}],\"lint\":{\"use\":[\"MINIMAL\"],\"except\":[\"PACKAGE_DIRECTORY_MATCH\"]}}' && buf format proto --diff --exit-code",
    "proto:check": "pnpm proto:lint && buf build proto -o /dev/null"
  },
  "keywords": [
    "chrome-extension",
    "tab-manager",
    "browser-extension"
  ],
  "author": "lx223",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.1.29",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "hot-reload-extension-vite": "^1.1.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
